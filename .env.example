# =============================================================================
#  HubChat — ตัวอย่างค่าตั้งระบบ
#  คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
#    cp .env.example .env.local
#
#  ⚠️ .env.local ห้ามขึ้น GitHub เด็ดขาด (มีใน .gitignore แล้ว)
# =============================================================================

# -----------------------------------------------------------------------------
#  1) Supabase  — หาได้จาก Supabase → Project Settings → API
# -----------------------------------------------------------------------------
# URL ของโปรเจกต์ เช่น https://abcdefghijk.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon public key — ปลอดภัยที่จะให้เบราว์เซอร์เห็น (เราเปิด RLS ปิดตายไว้แล้ว)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — ⚠️ ความลับสูงสุด ข้าม RLS ได้ทั้งหมด
# ห้ามใส่ในตัวแปรที่ขึ้นต้นด้วย NEXT_PUBLIC_ และห้ามส่งให้ใครเด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
#  2) ระบบเข้าสู่ระบบ
# -----------------------------------------------------------------------------
# กุญแจเซ็น session cookie — สร้างด้วย : openssl rand -base64 48
# เปลี่ยนค่านี้ = ทุกคนหลุดออกจากระบบทันที
SESSION_SECRET=

# อายุ session (ชั่วโมง) — 720 = 30 วัน
SESSION_TTL_HOURS=720

# rate limit หน้า login (เช็คลิสต์ความปลอดภัยข้อ 3)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15


# -----------------------------------------------------------------------------
#  3) กุญแจเข้ารหัส access token ของเพจก่อนเก็บลง DB (เช็คลิสต์ข้อ 1)
#     สร้างด้วย : openssl rand -base64 32
#     ⚠️ ทำหายแล้วถอด token เดิมไม่ได้ ต้องเชื่อมเพจใหม่ทั้งหมด
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
#  4) ทั่วไป
# -----------------------------------------------------------------------------
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HubChat
TZ_DISPLAY=Asia/Bangkok


# -----------------------------------------------------------------------------
#  5) ใช้ครั้งเดียวตอนสร้างบัญชีเจ้าของ — เสร็จแล้ว "ลบ 3 บรรทัดนี้ทิ้ง"
#     รัน : npm run create-owner
# -----------------------------------------------------------------------------
OWNER_NAME=
OWNER_EMAIL=
# ไม่ใส่ = ระบบสุ่มรหัสให้แล้วพิมพ์ออกหน้าจอ
OWNER_PASSWORD=


# =============================================================================
#  ด้านล่างนี้ยังไม่ใช้ในรอบนี้ — จองที่ไว้ ใส่ทีหลังได้ ไม่ใส่ก็รันได้ปกติ
# =============================================================================

# -----------------------------------------------------------------------------
#  Meta — จำเป็นตั้งแต่รอบ 3 (ทางเข้าของข้อมูล)
#  วิธีหาค่าทั้งหมด : ทำตาม docs/META_SETUP_TH.md ทีละขั้น
# -----------------------------------------------------------------------------
# App Settings → Basic
META_APP_ID=

# ⚠️ ความลับสูงสุด — ใช้ตรวจว่า webhook มาจาก Meta จริงไหม
#    ถ้าหลุด = ใครก็ปลอมเป็นลูกค้าทักเข้าระบบเราได้
META_APP_SECRET=

# ⚠️ ค่านี้ "คุณคิดเองได้เลย" ไม่ต้องขอจากใคร ขอแค่เดายาก
#    สร้างด้วย : openssl rand -hex 24
#    แล้วต้องกรอกค่าเดียวกันนี้ในหน้าตั้งค่า Webhook ของ Meta ด้วย
META_VERIFY_TOKEN=

META_GRAPH_VERSION=v21.0

# ตัวกวาดคิว webhook (npm run worker) — ตรวจคิวทุกกี่มิลลิวินาที
WORKER_INTERVAL_MS=2000

# =============================================================================
#  Message Policy Engine (สเปกหัวข้อ 6.1)
#  -----------------------------------------------------------------------------
#  กฎของ Meta ทั้งหมดอยู่ที่ src/server/policy/config.ts และปรับได้จากตรงนี้
#
#  ⚠️ ไม่ต้องใส่อะไรเลยก็รันได้ — ค่าเริ่มต้นคือ "เปิดเฉพาะการส่งปกติ"
#     ช่องทางที่เหลือปิดไว้หมดจนกว่าจะยืนยันกับเอกสาร Meta และได้รับอนุมัติจริง
#
#  ⚠️ Messenger กับ Instagram แยกกันคนละชุดโดยตั้งใจ
#     ห้ามสมมติว่าอะไรที่ทำได้บน Messenger จะทำได้บน Instagram ด้วย
# =============================================================================

# --- Messenger ---
# ส่งปกติหลังลูกค้าทักมา (ค่าเริ่มต้น 24 ชม.) — Meta เปลี่ยนกฎเมื่อไหร่ แก้ตรงนี้ที่เดียว
POLICY_MESSENGER_STANDARD_WINDOW_HOURS=24

# ตอบคำถามลูกค้าหลังพ้นกรอบปกติ — ต้องผ่าน App Review ก่อน
# ⚠️ ใช้ได้เฉพาะข้อความที่แอดมินพิมพ์เอง ห้ามใช้กับบอทหรือข้อความขาย
POLICY_MESSENGER_HUMAN_AGENT_ENABLED=false
POLICY_MESSENGER_HUMAN_AGENT_VERIFIED=false
POLICY_MESSENGER_HUMAN_AGENT_WINDOW_HOURS=168

# ข้อความแจ้งข้อมูลล้วนด้วยเทมเพลตที่อนุมัติแล้ว (แจ้งเลขพัสดุ ฯลฯ)
# ⚠️ ต้องอ่านเอกสารของ Meta ให้ชัดว่าใช้ได้จริงก่อนเปิด
POLICY_MESSENGER_UTILITY_ENABLED=false
POLICY_MESSENGER_UTILITY_VERIFIED=false
POLICY_MESSENGER_UTILITY_COST=0

# ข้อความการตลาด — เสียเงินรายข้อความ ต้องเช็คสิทธิ์รายบุคคลก่อนส่งทุกครั้ง
POLICY_MESSENGER_MARKETING_ENABLED=false
POLICY_MESSENGER_MARKETING_VERIFIED=false
POLICY_MESSENGER_MARKETING_COST=0

# --- Instagram (ตั้งค่าแยกจาก Messenger เสมอ) ---
POLICY_INSTAGRAM_STANDARD_WINDOW_HOURS=24
POLICY_INSTAGRAM_HUMAN_AGENT_ENABLED=false
POLICY_INSTAGRAM_HUMAN_AGENT_VERIFIED=false
POLICY_INSTAGRAM_HUMAN_AGENT_WINDOW_HOURS=168

# --- ทั่วไป ---
# ผลตรวจสิทธิ์รับข้อความการตลาดเก่าเกินกี่ชั่วโมงถือว่าใช้ไม่ได้
POLICY_MARKETING_ELIGIBILITY_MAX_AGE_HOURS=24

# ⚠️ ยอมให้ใช้ช่องทางที่ยังไม่ยืนยัน — ตั้ง true ได้เฉพาะตอนทดสอบในเครื่อง
#    🔴 บนเครื่องจริง (NODE_ENV=production) ถ้าตั้ง true ระบบจะ "ไม่ยอมสตาร์ต"
#       ตั้งใจให้พังดัง ๆ ดีกว่าปล่อยให้ส่งผิดนโยบายเงียบ ๆ
POLICY_ALLOW_UNVERIFIED_TRANSPORTS=false

# --- Cloudflare R2 (รอบ 3) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Telegram แจ้งเตือน (รอบ 7) — LINE Notify ปิดบริการแล้ว ห้ามใช้ ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
